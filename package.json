{
  "name": "pi-lego",
  "version": "0.1.0",
  "description": "Turn repeated agent corrections into reusable blocks.",
  "author": "Grant Hutchins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nertzy/pi-lego.git"
  },
  "homepage": "https://github.com/nertzy/pi-lego#readme",
  "bugs": {
    "url": "https://github.com/nertzy/pi-lego/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "agent-conventions",
    "guardrails"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extension.ts",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./blocks/head": "./src/blocks/head.ts",
    "./blocks/tail": "./src/blocks/tail.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run typecheck",
    "lint": "npm run lint:biome && npm run lint:markdown && actionlint .github/workflows/*.yml",
    "lint:biome": "biome check .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#tmp\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#tmp\""
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "unbash": "4.0.11"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
